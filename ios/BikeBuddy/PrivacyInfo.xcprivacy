<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Bike Buddy does not track users and does not collect any data, so both of
	  those arrays stay empty. Location is read on device to sort stations by
	  distance and is never sent anywhere - the CityBikes calls carry only the
	  selected network's href - so under Apple's definition (data transmitted off
	  the device) it is not "collected".
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  SettingsService stores the selected network, station count and
			  appearance mode in the app group suite. That is the app reading and
			  writing its own data, which is reason CA92.1.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
